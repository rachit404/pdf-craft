# PDF Craft settings. The installer copies this to /etc/pdf-craft/pdf-craft.env
# and fills in the secret, password hash and web address.
# After editing: sudo systemctl restart pdf-craft-api pdf-craft-web
# One KEY=value per line, no quotes.

# --- Where data lives ---------------------------------------------------------
PDF_CRAFT_STORAGE_DIR=/var/lib/pdf-craft/files
PDF_CRAFT_DATABASE_URL=sqlite:////var/lib/pdf-craft/pdf_craft.db

# --- Privacy: how long uploads and results are kept ---------------------------
# Files older than this many hours are deleted automatically. 0 keeps them.
PDF_CRAFT_RETENTION_HOURS=24

# --- Flows --------------------------------------------------------------------
# Reuse the files of a flow step when it runs again on identical files. 0 turns it off.
PDF_CRAFT_FLOW_CACHE=1
# Most files one flow step may handle, and seconds a whole run may take.
PDF_CRAFT_FLOW_MAX_ITEMS=50
PDF_CRAFT_FLOW_TIMEOUT=600

# --- Limits -------------------------------------------------------------------
PDF_CRAFT_MAX_UPLOAD_MB=25
PDF_CRAFT_MAX_IMAGE_MB=10
# Word/PowerPoint conversions (LibreOffice): at once, and seconds before giving up.
PDF_CRAFT_OFFICE_WORKERS=2
PDF_CRAFT_OFFICE_TIMEOUT=120

# --- Sign-in ------------------------------------------------------------------
# Set by the installer. Change the password with: sudo bash deploy/set-password.sh
PDF_CRAFT_PASSWORD_HASH=
PDF_CRAFT_SECRET=
PDF_CRAFT_SESSION_HOURS=168
# 1 when the site is served over HTTPS (the installer sets this).
PDF_CRAFT_COOKIE_SECURE=1

# --- Web server (set by the installer) ------------------------------------------
HOSTNAME=127.0.0.1
PORT=3000
