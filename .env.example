# Settings for docker compose. Copy to .env and edit:  cp .env.example .env
# One KEY=value per line. Keep the single quotes around the password hash.

# --- Address -------------------------------------------------------------------
# The name or IP address you will type in the browser.
SITE_ADDRESS=pdf.home.lan
# "internal" makes a private certificate (for LAN names and IPs).
# For a public domain, put your email address here to get a Let's Encrypt certificate.
TLS_MODE=internal

# --- Sign-in (strongly recommended) --------------------------------------------
# Password hash:   docker compose run --rm api python -m app.auth
# Secret:          openssl rand -hex 32
PDF_CRAFT_PASSWORD_HASH=''
PDF_CRAFT_SECRET=
PDF_CRAFT_SESSION_HOURS=168
# 1 because Caddy serves the site over HTTPS. Use 0 only if you test over plain HTTP.
PDF_CRAFT_COOKIE_SECURE=1

# --- Word and PowerPoint to PDF ------------------------------------------------
# 1 builds the API image with LibreOffice (about 600 MB more, accurate conversions).
WITH_LIBREOFFICE=0

# --- Privacy and limits --------------------------------------------------------
# Files older than this many hours are deleted automatically. 0 keeps them.
PDF_CRAFT_RETENTION_HOURS=24
PDF_CRAFT_MAX_UPLOAD_MB=25
PDF_CRAFT_MAX_IMAGE_MB=10
# Keep this a little above PDF_CRAFT_MAX_UPLOAD_MB.
MAX_BODY=40MB
